# Saltos de línea normalizados: LF en el repositorio y en la copia de trabajo, en cualquier sistema
# (evita que Windows marque archivos como modificados solo por CRLF y que Prettier falle).
* text=auto eol=lf

# Scripts de Windows: CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios: nunca convertir
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
