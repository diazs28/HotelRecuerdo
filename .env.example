# Variables de docker-compose.yml. Copia este archivo como .env en la raíz y completa los valores.
# NUNCA subas .env al repositorio.
# Genera cada secreto con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- PostgreSQL ---
POSTGRES_USER=hotel
# Solo letras y números (se usa dentro de la URL de conexión)
POSTGRES_PASSWORD=
POSTGRES_DB=hotel_el_recuerdo
# Rol con el que se conecta la API (solo lee y escribe datos; lo crea el paso de migraciones)
APP_DB_USER=hotel_app
# 16 o más letras y números
APP_DB_PASSWORD=
# Puerto publicado SOLO en este equipo (127.0.0.1), para desarrollar con npm run dev
POSTGRES_PORT=5436

# --- API ---
# Secreto para firmar las sesiones del personal (mínimo 32 caracteres)
JWT_SECRET=
# Duración de la sesión del personal, en minutos (máximo 720)
JWT_TTL_MIN=120
# Proxies delante de la API: 1 = el contenedor web (nginx). En producción (Caddy + nginx) se usa 2
TRUST_PROXY=1
# Orígenes que pueden llamar la API desde el navegador
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=info

# --- Sitio web ---
# Puerto publicado del sitio (http://localhost:8080)
WEB_PORT=8080
# URL pública del sitio (enlace canónico e imagen para redes). En producción se usa https://DOMINIO
SITIO_URL=http://localhost:8080

# --- Solo producción (docker-compose.prod.yml) ---
# Dominio del sitio, con el DNS apuntando al servidor (HTTPS automático con Caddy)
DOMINIO=
