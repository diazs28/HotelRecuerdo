// Esquema Prisma de Hotel El Recuerdo.
// Tablas y columnas en snake_case (@@map / @map); el código TypeScript usa camelCase.
//
// Lo que Prisma no expresa vive en SQL dentro de las migraciones:
//   - CHECK de fechas, cantidades y coherencia de estados;
//   - la restricción de exclusión (btree_gist) que impide que una cama tenga dos ocupaciones
//     activas con noches que se cruzan (reservas o bloqueos): ver docs/adr/0002;
//   - el trigger que vuelve inmutable la tabla de auditoría.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum EstadoReserva {
  SOLICITUD
  PENDIENTE_CONFIRMACION
  CONFIRMADA
  EN_ALOJAMIENTO
  FINALIZADA
  CANCELADA

  @@map("estado_reserva")
}

enum TipoBloqueo {
  BLOQUEO
  MANTENIMIENTO

  @@map("tipo_bloqueo")
}

enum TipoOcupacion {
  RESERVA
  BLOQUEO

  @@map("tipo_ocupacion")
}

enum TipoCama {
  SENCILLA
  SEMIDOBLE
  DOBLE
  QUEEN
  KING
  LITERA
  AUXILIAR

  @@map("tipo_cama")
}

enum TipoDocumento {
  CC
  CE
  PASAPORTE
  TI
  PPT
  OTRO

  @@map("tipo_documento")
}

// ------------------------------------------------------------
// USUARIOS DEL PERSONAL, ROLES Y PERMISOS
// ------------------------------------------------------------

model Usuario {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre       String    @db.VarChar(150)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  rolId        String    @map("rol_id") @db.Uuid
  activo       Boolean   @default(true)
  // Se incrementa al cerrar sesión o cambiar la contraseña: invalida los tokens anteriores
  versionToken Int       @default(0) @map("version_token")
  ultimoAcceso DateTime? @map("ultimo_acceso") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  rol                 Rol         @relation(fields: [rolId], references: [id], onDelete: Restrict)
  reservasResponsable Reserva[]   @relation("ReservaResponsable")
  reservasCreadas     Reserva[]   @relation("ReservaCreadaPor")
  bloqueosCreados     Bloqueo[]   @relation("BloqueoCreadoPor")
  bloqueosLiberados   Bloqueo[]   @relation("BloqueoLiberadoPor")
  auditoria           Auditoria[]
  ajustesActualizados Ajuste[]

  @@index([rolId])
  @@map("usuarios")
}

model Rol {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo      String   @unique @db.VarChar(40)
  nombre      String   @db.VarChar(80)
  descripcion String?  @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuarios Usuario[]
  permisos RolPermiso[]

  @@map("roles")
}

model Permiso {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo      String @unique @db.VarChar(60)
  descripcion String @db.VarChar(200)

  roles RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     String @map("rol_id") @db.Uuid
  permisoId String @map("permiso_id") @db.Uuid

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@index([permisoId])
  @@map("rol_permisos")
}

// ------------------------------------------------------------
// CATÁLOGOS CONFIGURABLES
// ------------------------------------------------------------

model TipoHabitacion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre            String   @unique @db.VarChar(80)
  descripcion       String?  @db.VarChar(500)
  // Personas que admite normalmente este tipo (orientativo; la capacidad real es la de cada habitación)
  capacidadSugerida Int?     @map("capacidad_sugerida")
  // Visible como opción en el formulario público de solicitud
  publicado         Boolean  @default(true)
  activo            Boolean  @default(true)
  orden             Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  habitaciones Habitacion[]
  reservas     Reserva[]

  @@map("tipos_habitacion")
}

model Canal {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // "web" es el canal del formulario público y no se puede desactivar
  codigo    String   @unique @db.VarChar(30)
  nombre    String   @db.VarChar(80)
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  reservas Reserva[]

  @@map("canales")
}

// Datos configurables del hotel (contacto, servicios, horarios, políticas, tarifas...).
// Un ajuste solo se muestra en el sitio público si está confirmado por la administración Y publicado
// (CHECK ajustes_publicado_requiere_confirmado).
model Ajuste {
  clave            String   @id @db.VarChar(40)
  valor            Json     @db.JsonB
  confirmado       Boolean  @default(false)
  publicado        Boolean  @default(false)
  actualizadoPorId String?  @map("actualizado_por_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  actualizadoPor Usuario? @relation(fields: [actualizadoPorId], references: [id], onDelete: SetNull)

  @@index([actualizadoPorId])
  @@map("ajustes")
}

// ------------------------------------------------------------
// HABITACIONES, CAMAS Y BLOQUEOS
// ------------------------------------------------------------

model Habitacion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Número o nombre visible ("101", "Suite Jardín"). Único entre las habitaciones activas.
  numero           String   @db.VarChar(30)
  tipoHabitacionId String   @map("tipo_habitacion_id") @db.Uuid
  // Personas que admite la habitación
  capacidad        Int
  piso             String?  @db.VarChar(20)
  descripcion      String?  @db.VarChar(500)
  // false = retirada del inventario (no se borra: tiene historial)
  activa           Boolean  @default(true)
  orden            Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tipoHabitacion TipoHabitacion @relation(fields: [tipoHabitacionId], references: [id], onDelete: Restrict)
  camas          Cama[]
  bloqueos       Bloqueo[]

  @@unique([numero], map: "habitaciones_numero_activa_key", where: { activa: true })
  @@index([tipoHabitacionId])
  @@map("habitaciones")
}

model Cama {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habitacionId  String   @map("habitacion_id") @db.Uuid
  // Identificador dentro de la habitación ("A", "1", "Litera sup.")
  identificador String   @db.VarChar(30)
  tipo          TipoCama
  // Personas que duermen en la cama (1 sencilla, 2 doble...)
  plazas        Int      @default(1)
  // false = retirada (no se borra: tiene historial de ocupaciones)
  activa        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  habitacion  Habitacion  @relation(fields: [habitacionId], references: [id], onDelete: Restrict)
  ocupaciones Ocupacion[]
  bloqueos    Bloqueo[]

  @@unique([habitacionId, identificador], map: "camas_habitacion_identificador_activa_key", where: { activa: true })
  @@index([habitacionId])
  @@map("camas")
}

// Bloqueo o mantenimiento de una habitación completa (camaId null) o de una cama.
// fechaFin es EXCLUSIVA (primer día en que vuelve a estar disponible); null = sin fecha de fin.
model Bloqueo {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo          TipoBloqueo
  habitacionId  String      @map("habitacion_id") @db.Uuid
  camaId        String?     @map("cama_id") @db.Uuid
  fechaInicio   DateTime    @map("fecha_inicio") @db.Date
  fechaFin      DateTime?   @map("fecha_fin") @db.Date
  motivo        String      @db.VarChar(300)
  creadoPorId   String      @map("creado_por_id") @db.Uuid
  liberadoEn    DateTime?   @map("liberado_en") @db.Timestamptz(6)
  liberadoPorId String?     @map("liberado_por_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  habitacion  Habitacion  @relation(fields: [habitacionId], references: [id], onDelete: Restrict)
  cama        Cama?       @relation(fields: [camaId], references: [id], onDelete: Restrict)
  creadoPor   Usuario     @relation("BloqueoCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  liberadoPor Usuario?    @relation("BloqueoLiberadoPor", fields: [liberadoPorId], references: [id], onDelete: Restrict)
  ocupaciones Ocupacion[]

  @@index([habitacionId, fechaInicio])
  @@index([camaId])
  @@index([creadoPorId])
  @@index([liberadoPorId])
  @@map("bloqueos")
}

// Noches que una cama está tomada por una reserva o por un bloqueo, en el rango [fechaInicio, fechaFin).
// La restricción de exclusión ocupaciones_cama_sin_cruce (migración) impide dos ocupaciones ACTIVAS de
// la misma cama con noches en común, incluso con solicitudes simultáneas.
model Ocupacion {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  camaId      String        @map("cama_id") @db.Uuid
  tipo        TipoOcupacion
  reservaId   String?       @map("reserva_id") @db.Uuid
  bloqueoId   String?       @map("bloqueo_id") @db.Uuid
  fechaInicio DateTime      @map("fecha_inicio") @db.Date
  fechaFin    DateTime?     @map("fecha_fin") @db.Date
  activa      Boolean       @default(true)
  liberadaEn  DateTime?     @map("liberada_en") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  cama    Cama     @relation(fields: [camaId], references: [id], onDelete: Restrict)
  reserva Reserva? @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  bloqueo Bloqueo? @relation(fields: [bloqueoId], references: [id], onDelete: Restrict)

  @@index([camaId, fechaInicio])
  @@index([reservaId])
  @@index([bloqueoId])
  @@map("ocupaciones_cama")
}

// ------------------------------------------------------------
// HUÉSPEDES Y RESERVAS
// ------------------------------------------------------------

// Datos mínimos para gestionar la estancia (Ley 1581 de 2012: finalidad y minimización).
model Huesped {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombres          String         @db.VarChar(100)
  apellidos        String         @db.VarChar(100)
  tipoDocumento    TipoDocumento? @map("tipo_documento")
  numeroDocumento  String?        @map("numero_documento") @db.VarChar(30)
  telefono         String?        @db.VarChar(30)
  email            String?        @db.VarChar(255)
  // Autorización de tratamiento de datos: cuándo y con qué versión del texto
  consentimientoEn DateTime?      @map("consentimiento_en") @db.Timestamptz(6)
  versionPolitica  String?        @map("version_politica") @db.VarChar(20)
  // Supresión (Ley 1581): los datos personales se reemplazan; la reserva conserva su historial
  anonimizadoEn    DateTime?      @map("anonimizado_en") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  reservas Reserva[]

  @@index([telefono])
  @@index([apellidos, nombres])
  @@map("huespedes")
}

model Reserva {
  id                        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Número legible para el personal y el huésped; el código es "HR-" + número con ceros
  numero                    Int           @unique @default(autoincrement())
  estado                    EstadoReserva
  canalId                   String        @map("canal_id") @db.Uuid
  huespedId                 String        @map("huesped_id") @db.Uuid
  // Fechas de calendario en la zona horaria del hotel. Ocupa las noches [fechaEntrada, fechaSalida).
  fechaEntrada              DateTime      @map("fecha_entrada") @db.Date
  fechaSalida               DateTime      @map("fecha_salida") @db.Date
  cantidadHuespedes         Int           @map("cantidad_huespedes")
  tipoHabitacionPreferidoId String?       @map("tipo_habitacion_preferido_id") @db.Uuid
  // Comentario que deja el huésped en la solicitud
  comentarioHuesped         String?       @map("comentario_huesped") @db.VarChar(1000)
  notasOperativas           String?       @map("notas_operativas") @db.VarChar(2000)
  responsableId             String?       @map("responsable_id") @db.Uuid
  creadoPorId               String?       @map("creado_por_id") @db.Uuid
  confirmadaEn              DateTime?     @map("confirmada_en") @db.Timestamptz(6)
  canceladaEn               DateTime?     @map("cancelada_en") @db.Timestamptz(6)
  motivoCancelacion         String?       @map("motivo_cancelacion") @db.VarChar(500)
  // Idempotencia: misma clave + mismo contenido = misma reserva (no se duplica)
  claveIdempotencia         String?       @unique @map("clave_idempotencia") @db.VarChar(160)
  huellaSolicitud           String?       @map("huella_solicitud") @db.Char(64)
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  canal                   Canal           @relation(fields: [canalId], references: [id], onDelete: Restrict)
  huesped                 Huesped         @relation(fields: [huespedId], references: [id], onDelete: Restrict)
  tipoHabitacionPreferido TipoHabitacion? @relation(fields: [tipoHabitacionPreferidoId], references: [id], onDelete: Restrict)
  responsable             Usuario?        @relation("ReservaResponsable", fields: [responsableId], references: [id], onDelete: Restrict)
  creadoPor               Usuario?        @relation("ReservaCreadaPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  ocupaciones             Ocupacion[]

  @@index([estado, fechaEntrada])
  @@index([fechaEntrada, fechaSalida])
  @@index([huespedId])
  @@index([canalId])
  @@index([tipoHabitacionPreferidoId])
  @@index([responsableId])
  @@index([creadoPorId])
  @@index([createdAt])
  @@map("reservas")
}

// ------------------------------------------------------------
// AUDITORÍA (inmutable) Y SOPORTE
// ------------------------------------------------------------

// Cambios relevantes: quién, qué, cuándo. "datos" guarda solo lo mínimo (estados, fechas, ids),
// nunca datos personales del huésped. Un trigger impide UPDATE y DELETE.
model Auditoria {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String?  @map("usuario_id") @db.Uuid
  accion    String   @db.VarChar(60)
  entidad   String   @db.VarChar(40)
  entidadId String   @map("entidad_id") @db.Uuid
  datos     Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([entidad, entidadId, createdAt])
  @@index([usuarioId])
  @@index([createdAt])
  @@map("auditoria")
}

// Contadores del rate limiting (persistentes y compartidos entre instancias)
model LimiteTasa {
  clave    String   @id @db.VarChar(300)
  hits     Int
  reinicio DateTime @db.Timestamptz(6)

  @@map("limites_tasa")
}
