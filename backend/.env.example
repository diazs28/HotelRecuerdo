# Variables para desarrollar la API con "npm run dev" (copiar como backend/.env y completar).
# NUNCA subas .env al repositorio. La base se levanta con "docker compose up -d db" desde la raíz.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Usuario y contraseña: los mismos POSTGRES_USER / POSTGRES_PASSWORD del .env de la raíz
DATABASE_URL=postgresql://hotel:CAMBIAR@localhost:5436/hotel_el_recuerdo
# Base de pruebas (npm test la VACÍA en cada ejecución). La crea docker/postgres/01-bd-pruebas.sh
TEST_DATABASE_URL=postgresql://hotel:CAMBIAR@localhost:5436/hotel_el_recuerdo_test
# Opcional: rol dueño de las tablas para migrar (si la API usa un rol con menos privilegios)
MIGRATION_DATABASE_URL=

# Orígenes del navegador permitidos (el frontend de Vite)
CORS_ORIGINS=http://localhost:5173
# 0 = sin proxy delante de la API (desarrollo)
TRUST_PROXY=0

# Secreto de las sesiones del personal (mínimo 32 caracteres)
JWT_SECRET=
JWT_TTL_MIN=480

# Límites (opcionales; vacíos = valor por defecto)
# Global por IP: ventana en ms (15 min) y máximo de peticiones
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
# Login: intentos fallidos por IP + correo en la ventana (por defecto 5 en 15 min)
AUTH_RATE_LIMIT_WINDOW_MS=
AUTH_RATE_LIMIT_MAX=5
# Formulario público: solicitudes por IP en la ventana (por defecto 5 por hora)
SOLICITUDES_RATE_LIMIT_WINDOW_MS=
SOLICITUDES_RATE_LIMIT_MAX=5
# Consultas públicas de disponibilidad por IP cada 15 min (por defecto 60)
DISPONIBILIDAD_RATE_LIMIT_MAX=

# Emisor de los tokens (por defecto hotel-el-recuerdo-api)
JWT_ISSUER=
# Swagger en /api/docs: true/false (por defecto activo fuera de producción)
API_DOCS_ENABLED=

# Primer administrador para "npm run db:seed" (opcional; también "npm run crear-admin")
SEED_ADMIN_NOMBRE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
